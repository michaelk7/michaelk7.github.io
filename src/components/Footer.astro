---
import { SITE } from '../consts';
---

<footer>
  <div class="wrap">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <span class="links">
      <a href="/rss.xml">rss</a>
      <a href="/pgp.asc">pgp</a>
      <a href={SITE.github} rel="me">github</a>
      <a href={SITE.linkedin} rel="me">linkedin</a>
    </span>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding: 32px 0 48px; }
  .wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-family: var(--mono); font-size: 12.5px; color: var(--faint); }
  .links { display: flex; gap: 20px; flex-wrap: wrap; }
  a:hover { color: var(--accent); }
</style>
