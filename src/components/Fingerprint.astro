---
import { SITE } from '../consts';
---

<div class="fpr">
  <div>
    <small>PGP fingerprint</small>
    <code>{SITE.pgpFingerprint}</code>
  </div>
  <a class="dl" href="/pgp.asc" download="michael-kelnar.asc">download .asc</a>
</div>

<style>
  .fpr {
    margin-top: 32px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 8px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    background: var(--bg-raised);
  }
  code { font-family: var(--mono); font-size: 13px; color: var(--text); word-break: break-all; }
  small { display: block; font-family: var(--mono); font-size: 11.5px; color: var(--faint); margin-bottom: 4px; }
  .dl {
    font-family: var(--mono); font-size: 12px; color: var(--muted);
    border: 1px solid var(--line); border-radius: 5px; padding: 6px 10px;
  }
  .dl:hover { color: var(--text); border-color: var(--faint); }
</style>
