---
interface Props {
  num: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { num, title, href, linkLabel } = Astro.props;
---

<div class="sec-head">
  <h2><span>{num}</span> / {title}</h2>
  {href && <a href={href}>{linkLabel} →</a>}
</div>

<style>
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 36px; gap: 16px; }
  h2 { font-family: var(--mono); font-size: 13px; font-weight: 400; color: var(--muted); letter-spacing: 0.02em; }
  h2 span { color: var(--accent); }
  a { font-family: var(--mono); font-size: 13px; color: var(--muted); }
  a:hover { color: var(--accent); }
</style>
